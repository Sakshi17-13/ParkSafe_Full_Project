PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/parksafe
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Point to a Firebase Admin service-account JSON stored outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/parksafe-firebase-admin.json
# Optional when the project ID cannot be inferred from the credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
